generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cagnotte {
  id               String   @id @default(uuid())
  platform         String   // e.g. "cotizup", "leetchi", "helloasso"
  titre            String
  description      String? 
  lien             String   @unique
  image            String? 
  status           String? 
  category         String?  // "Défunt", "Construction Mosquées", ...
  country          String?  // "FR"
  created_at       DateTime @default(now())
  start_date       DateTime? 
  end_date         DateTime?
  scraped_at       DateTime @default(now())
}
